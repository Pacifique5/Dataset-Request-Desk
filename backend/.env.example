# Copy to .env and adjust. Never commit the real .env.
APP_ENV=development
# Local Postgres, user "postgres" with no password
DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/dataset_desk
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=60
# Local development runs over plain HTTP; keep true anywhere behind HTTPS.
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
